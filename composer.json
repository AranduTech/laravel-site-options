{
    "name": "arandu/laravel-site-options",
    "autoload": {
        "psr-4": {
            "Arandu\\LaravelSiteOptions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arandu\\LaravelSiteOptions\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Bruno Polo",
            "email": "brunopolo@poli.ufrj.br"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arandu\\LaravelSiteOptions\\SiteOptionsServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
